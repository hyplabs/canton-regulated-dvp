module Settlement.TokenizedPaymentTest where

import DA.Optional (fromSome)
import DA.TextMap as TextMap
import DA.Time (addRelTime, days)
import Daml.Script

import Settlement.PrivateCreditToken
import Settlement.Regulated
import Settlement.TokenizedPayment
import Splice.Api.Token.AllocationRequestV1
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.MetadataV1

data TokenizedTestParties = TokenizedTestParties
  with
    issuer : Party
    investor : Party
    verifier : Party
    custodian : Party
    auditor : Party
    paymentInstrumentAdmin : Party
  deriving (Eq, Show)

data TokenizedRequestFixture = TokenizedRequestFixture
  with
    parties : TokenizedTestParties
    terms : SettlementTerms
    agreementCid : ContractId PurchaseAgreement
    requestCid : ContractId TokenizedPaymentRequest
    request : TokenizedPaymentRequest
    expectedPaymentAllocation : AllocationSpecification
    expectedDeliveryAllocation : AllocationSpecification
  deriving (Eq, Show)

template MockPaymentAllocation
  with
    allocation : AllocationSpecification
  where
    signatory allocation.transferLeg.instrumentId.admin,
      allocation.transferLeg.sender
    observer allocation.settlement.executor,
      allocation.transferLeg.receiver

    interface instance Allocation for MockPaymentAllocation where
      view = AllocationView with
        allocation
        holdingCids = []
        meta = emptyMetadata

      allocation_executeTransferImpl _ _ = do
        _ <- create MockPaymentTransferReceipt with allocation
        pure Allocation_ExecuteTransferResult with
          senderHoldingCids = []
          receiverHoldingCids = []
          meta = emptyMetadata

      allocation_cancelImpl _ _ =
        pure Allocation_CancelResult with
          senderHoldingCids = []
          meta = emptyMetadata

      allocation_withdrawImpl _ _ =
        pure Allocation_WithdrawResult with
          senderHoldingCids = []
          meta = emptyMetadata

template MockPaymentTransferReceipt
  with
    allocation : AllocationSpecification
  where
    signatory allocation.transferLeg.sender,
      allocation.transferLeg.receiver,
      allocation.settlement.executor

allocateParties : Text -> Script TokenizedTestParties
allocateParties prefix = do
  issuer <- allocatePartyByHint (PartyIdHint (prefix <> "-issuer"))
  investor <- allocatePartyByHint (PartyIdHint (prefix <> "-investor"))
  verifier <- allocatePartyByHint (PartyIdHint (prefix <> "-verifier"))
  custodian <- allocatePartyByHint (PartyIdHint (prefix <> "-custodian"))
  auditor <- allocatePartyByHint (PartyIdHint (prefix <> "-auditor"))
  paymentInstrumentAdmin <-
    allocatePartyByHint (PartyIdHint (prefix <> "-payment-admin"))
  pure TokenizedTestParties with ..

termsFor : TokenizedTestParties -> SettlementTerms
termsFor parties = SettlementTerms with
  issuer = parties.issuer
  investor = parties.investor
  verifier = parties.verifier
  custodian = parties.custodian
  auditor = parties.auditor
  assetId = "PC-NOTE-2026-09"
  assetClass = "PRIVATE-CREDIT"
  units = 1000
  paymentAmount = 250.0
  paymentInstrumentId = "CC"

setupRequestFixture : Text -> Script TokenizedRequestFixture
setupRequestFixture prefix = do
  parties <- allocateParties prefix
  let terms = termsFor parties
  now <- getTime
  let offerExpiresAt = now `addRelTime` days 1
  let allocateBefore = now `addRelTime` days 2
  let settleBefore = now `addRelTime` days 7
  let paymentInstrumentId = InstrumentId with
        admin = parties.paymentInstrumentAdmin
        id = terms.paymentInstrumentId
  let assetInstrumentId = InstrumentId with
        admin = parties.custodian
        id = terms.assetId

  eligibilityAttestationCid <- submit parties.verifier do
    createCmd EligibilityAttestation with
      verifier = parties.verifier
      investor = parties.investor
      assetClass = terms.assetClass
      expiresAt = now `addRelTime` days 30

  offerCid <- submit parties.issuer do
    createCmd AssetOffer with
      terms
      offerExpiresAt
      settleBefore

  compliancePendingCid <- submit parties.investor do
    exerciseCmd offerCid AcceptOffer with ..

  agreementCid <- submit parties.verifier do
    exerciseCmd compliancePendingCid ApproveCompliance

  let requestId = prefix <> "-dvp-001"
  proposalCid <- submit parties.issuer do
    createCmd TokenizedPaymentProposal with
      requestId
      terms
      agreementCid
      eligibilityAttestationCid
      paymentInstrumentId
      assetInstrumentId
      requestedAt = now
      allocateBefore
      settleBefore

  deliveryPendingCid <- submit parties.verifier do
    exerciseCmd proposalCid ApproveTokenizedPayment

  approvedCid <- submit parties.custodian do
    exerciseCmd deliveryPendingCid ApprovePrivateCreditDelivery

  requestCid <- submit parties.investor do
    exerciseCmd approvedCid AcceptTokenizedPayment

  Some request <- queryContractId parties.investor requestCid
  let requestView = view $ toInterface @AllocationRequest request
  let paymentTransferLeg =
        fromSome $ TextMap.lookup paymentLegId requestView.transferLegs
  let deliveryTransferLeg =
        fromSome $ TextMap.lookup deliveryLegId requestView.transferLegs
  let expectedPaymentAllocation = AllocationSpecification with
        settlement = requestView.settlement
        transferLegId = paymentLegId
        transferLeg = paymentTransferLeg
  let expectedDeliveryAllocation = AllocationSpecification with
        settlement = requestView.settlement
        transferLegId = deliveryLegId
        transferLeg = deliveryTransferLeg

  pure TokenizedRequestFixture with ..

createMockPaymentAllocation
  : TokenizedRequestFixture
  -> AllocationSpecification
  -> Script (ContractId MockPaymentAllocation)
createMockPaymentAllocation fixture allocation =
  submit (actAs
    [fixture.parties.paymentInstrumentAdmin, fixture.parties.investor]) do
    createCmd MockPaymentAllocation with ..

completeDvP
  : TokenizedRequestFixture
  -> ContractId MockPaymentAllocation
  -> Script (ContractId TokenizedSettlementReceipt)
completeDvP fixture paymentAllocationCid =
  submit (actAs [fixture.parties.issuer, fixture.parties.verifier]) do
    exerciseCmd fixture.requestCid CompleteTokenizedDvP with
      paymentAllocationCid = toInterfaceContractId paymentAllocationCid
      paymentExtraArgs = emptyExtraArgs
      deliveryExtraArgs = emptyExtraArgs

completeDvPMustFail
  : TokenizedRequestFixture
  -> ContractId MockPaymentAllocation
  -> Script ()
completeDvPMustFail fixture paymentAllocationCid =
  submitMustFail (actAs
    [fixture.parties.issuer, fixture.parties.verifier]) do
    exerciseCmd fixture.requestCid CompleteTokenizedDvP with
      paymentAllocationCid = toInterfaceContractId paymentAllocationCid
      paymentExtraArgs = emptyExtraArgs
      deliveryExtraArgs = emptyExtraArgs

emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with
  context = emptyChoiceContext
  meta = emptyMetadata

setupTokenizedPaymentDemo : Script (ContractId TokenizedSettlementReceipt)
setupTokenizedPaymentDemo = do
  fixture <- setupRequestFixture "token-demo"
  paymentAllocationCid <-
    createMockPaymentAllocation fixture fixture.expectedPaymentAllocation
  completeDvP fixture paymentAllocationCid

testTokenizedDvPHappyPath : Script ()
testTokenizedDvPHappyPath = script do
  fixture <- setupRequestFixture "token-happy"
  paymentAllocationCid <-
    createMockPaymentAllocation fixture fixture.expectedPaymentAllocation

  [(_, lockedHolding)] <-
    query @PrivateCreditLockedHolding fixture.parties.custodian
  assertMsg "Custodian reserved the exact private-credit delivery"
    (lockedHolding.amount == intToDecimal fixture.terms.units)

  receiptCid <- completeDvP fixture paymentAllocationCid

  None <- queryContractId fixture.parties.issuer fixture.requestCid
  None <- queryContractId fixture.parties.issuer fixture.agreementCid
  None <- queryContractId fixture.parties.issuer paymentAllocationCid
  None <- queryInterfaceContractId
    fixture.parties.issuer fixture.request.deliveryAllocationCid
  [] <- query @PrivateCreditLockedHolding fixture.parties.custodian

  [(_, paymentReceipt)] <-
    query @MockPaymentTransferReceipt fixture.parties.investor
  assertMsg "The Canton Coin allocation executed the requested payment leg"
    (paymentReceipt.allocation == fixture.expectedPaymentAllocation)

  [(_, assetHolding)] <- query @PrivateCreditHolding fixture.parties.investor
  assertMsg "The investor received the tokenized private-credit units"
    (assetHolding.owner == fixture.parties.investor
      && assetHolding.instrumentId.id == fixture.terms.assetId
      && assetHolding.amount == intToDecimal fixture.terms.units)

  Some receipt <- queryContractId fixture.parties.auditor receiptCid
  assertMsg "The final receipt references both executed allocations"
    (receipt.requestId == fixture.request.requestId
      && receipt.deliveryAllocationCid == fixture.request.deliveryAllocationCid
      && receipt.assetHoldingCids /= [])
  pure ()

testMismatchedPaymentCannotSettle : Script ()
testMismatchedPaymentCannotSettle = script do
  fixture <- setupRequestFixture "token-mismatch"
  let wrongTransferLeg = fixture.expectedPaymentAllocation.transferLeg with
        amount = fixture.terms.paymentAmount + 1.0
  let wrongAllocation = fixture.expectedPaymentAllocation with
        transferLeg = wrongTransferLeg
  paymentAllocationCid <- createMockPaymentAllocation fixture wrongAllocation

  completeDvPMustFail fixture paymentAllocationCid

  Some _ <- queryContractId fixture.parties.issuer fixture.requestCid
  Some _ <- queryContractId fixture.parties.issuer fixture.agreementCid
  Some _ <- queryContractId fixture.parties.issuer paymentAllocationCid
  Some _ <- queryInterfaceContractId
    fixture.parties.issuer fixture.request.deliveryAllocationCid
  [] <- query @MockPaymentTransferReceipt fixture.parties.investor
  [] <- query @PrivateCreditHolding fixture.parties.investor
  [] <- query @TokenizedSettlementReceipt fixture.parties.auditor
  pure ()

testPaymentForDifferentSettlementCannotSettle : Script ()
testPaymentForDifferentSettlementCannotSettle = script do
  fixture <- setupRequestFixture "token-wrong-settlement"
  let wrongSettlementRef =
        fixture.expectedPaymentAllocation.settlement.settlementRef with cid = None
  let wrongSettlement = fixture.expectedPaymentAllocation.settlement with
        settlementRef = wrongSettlementRef
  let wrongAllocation = fixture.expectedPaymentAllocation with
        settlement = wrongSettlement
  paymentAllocationCid <- createMockPaymentAllocation fixture wrongAllocation

  completeDvPMustFail fixture paymentAllocationCid

  Some _ <- queryContractId fixture.parties.issuer fixture.requestCid
  Some _ <- queryContractId fixture.parties.issuer paymentAllocationCid
  Some _ <- queryInterfaceContractId
    fixture.parties.issuer fixture.request.deliveryAllocationCid
  pure ()

testInactivePaymentAllocationCannotSettle : Script ()
testInactivePaymentAllocationCannotSettle = script do
  fixture <- setupRequestFixture "token-inactive-payment"
  paymentAllocationCid <-
    createMockPaymentAllocation fixture fixture.expectedPaymentAllocation

  submit (actAs
    [fixture.parties.paymentInstrumentAdmin, fixture.parties.investor]) do
    archiveCmd paymentAllocationCid

  completeDvPMustFail fixture paymentAllocationCid

  Some _ <- queryContractId fixture.parties.issuer fixture.requestCid
  None <- queryContractId fixture.parties.issuer paymentAllocationCid
  Some _ <- queryInterfaceContractId
    fixture.parties.issuer fixture.request.deliveryAllocationCid
  pure ()

testBrokenDeliveryRollsBackPayment : Script ()
testBrokenDeliveryRollsBackPayment = script do
  fixture <- setupRequestFixture "token-broken-delivery"
  paymentAllocationCid <-
    createMockPaymentAllocation fixture fixture.expectedPaymentAllocation
  [(lockedHoldingCid, _)] <-
    query @PrivateCreditLockedHolding fixture.parties.custodian

  submit fixture.parties.custodian do
    archiveCmd lockedHoldingCid

  completeDvPMustFail fixture paymentAllocationCid

  Some _ <- queryContractId fixture.parties.issuer fixture.requestCid
  Some _ <- queryContractId fixture.parties.issuer fixture.agreementCid
  Some _ <- queryContractId fixture.parties.issuer paymentAllocationCid
  Some _ <- queryInterfaceContractId
    fixture.parties.issuer fixture.request.deliveryAllocationCid
  [] <- query @MockPaymentTransferReceipt fixture.parties.investor
  [] <- query @PrivateCreditHolding fixture.parties.investor
  [] <- query @TokenizedSettlementReceipt fixture.parties.auditor
  pure ()

testExpiredTokenizedDvPCannotSettle : Script ()
testExpiredTokenizedDvPCannotSettle = script do
  fixture <- setupRequestFixture "token-expired"
  paymentAllocationCid <-
    createMockPaymentAllocation fixture fixture.expectedPaymentAllocation
  passTime (days 8)

  completeDvPMustFail fixture paymentAllocationCid

  Some _ <- queryContractId fixture.parties.issuer fixture.requestCid
  Some _ <- queryContractId fixture.parties.issuer paymentAllocationCid
  [] <- query @MockPaymentTransferReceipt fixture.parties.investor
  [] <- query @PrivateCreditHolding fixture.parties.investor
  pure ()

testWrongPartyCannotCompleteTokenizedDvP : Script ()
testWrongPartyCannotCompleteTokenizedDvP = script do
  fixture <- setupRequestFixture "token-wrong-party"
  paymentAllocationCid <-
    createMockPaymentAllocation fixture fixture.expectedPaymentAllocation

  submitMustFail fixture.parties.investor do
    exerciseCmd fixture.requestCid CompleteTokenizedDvP with
      paymentAllocationCid = toInterfaceContractId paymentAllocationCid
      paymentExtraArgs = emptyExtraArgs
      deliveryExtraArgs = emptyExtraArgs

  Some _ <- queryContractId fixture.parties.issuer fixture.requestCid
  Some _ <- queryContractId fixture.parties.issuer paymentAllocationCid
  Some _ <- queryInterfaceContractId
    fixture.parties.issuer fixture.request.deliveryAllocationCid
  pure ()
